# ==============================================================================
# Aurelle Weddings — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local to configure integrations locally.
# None of these values contain private secret keys; all are client-facing identifiers.

# Canonical Website URL
NEXT_PUBLIC_SITE_URL=https://aurelleweddings.com

# ------------------------------------------------------------------------------
# MyFormCapture — Wedding Enquiry Form Integration
# ------------------------------------------------------------------------------
# Endpoint for capturing enquiry submissions.
# Replace with your production MyFormCapture form endpoint.
NEXT_PUBLIC_MYFORMCAPTURE_ENDPOINT=https://api.myformconnect.com/v1/capture

# Your unique MyFormCapture Form UUID for Aurelle Weddings
NEXT_PUBLIC_MYFORMCAPTURE_FORM_ID=

# ------------------------------------------------------------------------------
# MyFormConnect — 15-Minute Consultation Booking Widget
# ------------------------------------------------------------------------------
# Widget script and stylesheet URLs (leave default or update if using custom host)
NEXT_PUBLIC_MYFORMCONNECT_WIDGET_JS_URL=https://widget.myformconnect.com/embed.js
NEXT_PUBLIC_MYFORMCONNECT_WIDGET_CSS_URL=https://widget.myformconnect.com/embed.css

# Your dedicated MyFormConnect Booking Form UUID for Aurelle Weddings
NEXT_PUBLIC_MYFORMCONNECT_BOOKING_FORM_ID=
